# ROM images are not distributed.  Supply your own MAME astdelux set and
# regenerate everything with disasm/gen_from_roms.py (see disasm/README.md).
roms/
disasm/*_dump.bin
disasm/*_dvgprom.bin

# Atari's source archive (github.com/historicalsource/asteroids-deluxe)
# is not distributed either; the name tables recovered from it are.  A
# local copy here lets the naming tools regenerate them.
asteroids-deluxe-main/

# Python
__pycache__/
*.pyc

# Local development records, not part of the published project
STATUS.md
c_src/POKEY_AAE_BACKPORT.md
docs/superpowers/
.claude/

# The Teensy Vector Emulation PCB's design files (KiCad project,
# schematics, layout, design notes) live outside this repo and are not
# published; these patterns keep a stray copy out.
*.kicad_*
*.kicad_pro
*.sch
fp-info-cache
*[Mm]asteroids*

# Reference material dropped into the tree for study, not distributed
atari_pokey-main/

# C conversion build output
c_src/obj/
*.exe
!c_src/astdelux_win.exe
*.obj
*.pdb
*.ilk

# The test builds (c_src/tests) and the hosts' runtime output.  The window
# host writes astdelux_win.ini itself with every key at its default on
# the first run; the tracked copy and astdelux_win.exe are the published
# defaults and build.
c_src/tests/obj/
c_src/tests/obj_*/
c_src/tests/*.bin
c_src/tests/*.dump
c_src/tests/*.html
c_src/*.log
c_src/*.nv
c_src/*.bin
c_src/*.html

# The Teensy backend's sketch: stage.py copies the game core and the
# converted samples into src/; arduino-cli --export-binaries writes build/.
c_src/platform/teensy/astdelux_teensy/src/
c_src/platform/teensy/astdelux_teensy/build/
